<Window
    x:Class="GrafikoMat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GrafikoMat"
    xmlns:converters="using:GrafikoMat.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:BooleanToPrimaryStyleConverter x:Key="BooleanToPrimaryStyleConverter">
                <converters:BooleanToPrimaryStyleConverter.PrimaryStyle>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
                </converters:BooleanToPrimaryStyleConverter.PrimaryStyle>
                <converters:BooleanToPrimaryStyleConverter.NormalStyle>
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"/>
                </converters:BooleanToPrimaryStyleConverter.NormalStyle>
            </converters:BooleanToPrimaryStyleConverter>

            <local:UiActionTemplateSelector x:Key="UiActionTemplateSelector">
                <local:UiActionTemplateSelector.NormalButtonTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}" Margin="6,0" MinWidth="120"/>
                    </DataTemplate>
                </local:UiActionTemplateSelector.NormalButtonTemplate>
                <local:UiActionTemplateSelector.PrimaryButtonTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource AccentButtonStyle}" Margin="6,0" MinWidth="120"/>
                    </DataTemplate>
                </local:UiActionTemplateSelector.PrimaryButtonTemplate>
            </local:UiActionTemplateSelector>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TopBarRow" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="TitleBarMenuButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="TitleBarMenuButton_Click">
                    <FontIcon Glyph="&#xE700;" FontSize="16"/>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Wyloguj" Click="OnLogout">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF3B1;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </StackPanel>

            <Border x:Name="DragBar" Grid.Column="1" Background="Transparent"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,140,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Opacity="0.8" Margin="0,0,12,0"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentViewTitle, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.9"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="UnitSelectionPanel" Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" Height="80" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid x:Name="UnitContextGrid" HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{x:Bind ViewModel.SwitchToPreviousUnitCommand}" Background="Transparent" BorderThickness="0" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" MinWidth="400">
                        <TextBlock Text="{x:Bind ViewModel.ActiveUnitHospitalName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveUnitDepartmentName, Mode=OneWay}" FontSize="14" Opacity="0.7" TextAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Command="{x:Bind ViewModel.SwitchToNextUnitCommand}" Background="Transparent" BorderThickness="0" Width="44" Height="44" VerticalAlignment="Center" Margin="16,0,0,0">
                        <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="MainContentPanel" Grid.Row="2" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Border.RenderTransform>
            <Grid>
                <ContentPresenter x:Name="ViewportCurrent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform X="0"/>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
                <ContentPresenter x:Name="ViewportNext" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Opacity="0">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform X="0"/>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Grid>
        </Border>

        <Grid x:Name="ActionButtonsPanel" Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,12" Opacity="0">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{x:Bind ActionsLeft}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Command}" MinWidth="120"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ActionsRight}" HorizontalAlignment="Right" ItemTemplateSelector="{StaticResource UiActionTemplateSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="BottomStatusBar" Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,0" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="20"/>
            </Grid.RenderTransform>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.EngineName, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PriorityOrder, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="InitialLoadingOverlay" Grid.RowSpan="5" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Ładowanie aplikacji..." FontSize="16" HorizontalAlignment="Center" Opacity="0.8"/>
            </StackPanel>
        </Grid>

        <ContentPresenter x:Name="StartupOverlayContent" Grid.RowSpan="5" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ContentPresenter x:Name="LoginOverlay" Grid.RowSpan="5" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>