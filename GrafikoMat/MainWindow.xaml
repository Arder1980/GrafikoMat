<Window
    x:Class="GrafikoMat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GrafikoMat"
    xmlns:converters="using:GrafikoMat.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <converters:BooleanToPrimaryStyleConverter x:Key="BooleanToPrimaryStyleConverter">
                <converters:BooleanToPrimaryStyleConverter.PrimaryStyle>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
                </converters:BooleanToPrimaryStyleConverter.PrimaryStyle>
                <converters:BooleanToPrimaryStyleConverter.NormalStyle>
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"/>
                </converters:BooleanToPrimaryStyleConverter.NormalStyle>
            </converters:BooleanToPrimaryStyleConverter>

            <local:UiActionTemplateSelector x:Key="UiActionTemplateSelector">
                <local:UiActionTemplateSelector.NormalButtonTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}" Margin="6,0" MinWidth="120"/>
                    </DataTemplate>
                </local:UiActionTemplateSelector.NormalButtonTemplate>
                <local:UiActionTemplateSelector.PrimaryButtonTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource AccentButtonStyle}" Margin="6,0" MinWidth="120"/>
                    </DataTemplate>
                </local:UiActionTemplateSelector.PrimaryButtonTemplate>
            </local:UiActionTemplateSelector>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- BELKA TYTUŁOWA -->
        <Grid x:Name="TopBarRow" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nazwa programu po lewej -->
            <TextBlock Grid.Column="0"
                       Text="GrafikoMat Dyżurowy"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Margin="16,0,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

            <!-- DragBar - obszar przeciągania okna -->
            <Border x:Name="DragBar" Grid.Column="1" Background="Transparent"/>

            <!-- Dane użytkownika wyśrodkowane w pionie -->
            <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="12,0">
                <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}"
               VerticalAlignment="Center"
               FontSize="12"
               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- Przycisk powiadomień -->
            <Button x:Name="NotificationButton"
                    Grid.Column="3"
                    Width="46"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Click="NotificationButton_Click">
                <Grid>
                    <FontIcon Glyph="&#xEA8F;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <InfoBadge x:Name="NotificationBadge"
                               Value="0"
                               Visibility="Collapsed"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,2,8,0"/>
                </Grid>
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="NotificationFlyout" Placement="BottomEdgeAlignedLeft">
                        <ScrollViewer Width="450" MaxHeight="500" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NotificationsContainer" Spacing="8">
                                <TextBlock x:Name="NoNotificationsText"
                                           Text="Brak nowych powiadomień"
                                           Visibility="Visible"
                                           HorizontalAlignment="Center"
                                           Margin="0,20"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </Button>

            <!-- Hamburger button po prawej (przed przyciskami okna) -->
            <Button x:Name="TitleBarMenuButton"
        Grid.Column="4"
        Width="46" 
        Height="30" 
        Background="Transparent" 
        BorderThickness="0"
        CornerRadius="0"
        Padding="0"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Margin="0,0,138,0"
        Click="TitleBarMenuButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyout.MenuFlyoutPresenterStyle>
                            <Style TargetType="MenuFlyoutPresenter">
                                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </MenuFlyout.MenuFlyoutPresenterStyle>
                        <MenuFlyoutItem Text="Pomoc" Click="OnHelp">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE897;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="O programie" Click="OnAbout">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Wyloguj" Click="OnLogout">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xF3B1;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
            </Button>
        </Grid>

        <!-- PANEL WYBORU JEDNOSTKI -->
        <Grid x:Name="UnitSelectionPanel" Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" Height="80" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid x:Name="UnitContextGrid" HorizontalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{x:Bind ViewModel.SwitchToPreviousUnitCommand}" Background="Transparent" BorderThickness="0" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" MinWidth="400">
                        <TextBlock Text="{x:Bind ViewModel.ActiveUnitHospitalName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveUnitDepartmentName, Mode=OneWay}" FontSize="14" Opacity="0.7" TextAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Command="{x:Bind ViewModel.SwitchToNextUnitCommand}" Background="Transparent" BorderThickness="0" Width="44" Height="44" VerticalAlignment="Center" Margin="16,0,0,0">
                        <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- GŁÓWNA ZAWARTOŚĆ -->
        <Border x:Name="MainContentPanel" Grid.Row="2" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ContentPresenter x:Name="ViewportCurrent" Content="{x:Null}"/>
                <ContentPresenter x:Name="ViewportNext" Content="{x:Null}"/>
            </Grid>
        </Border>

        <!-- PANEL AKCJI -->
        <!-- PANEL AKCJI -->
        <!-- Centralne miejsce dla przycisków akcji z widoków.
             Dla spójności UX, wszystkie główne przyciski akcji widoków powinny być
             rejestrowane tutaj przez MainWindow.RegisterViewActions() lub bezpośrednio
             przez modyfikację kolekcji ActionsLeft/ActionsRight.
             
             WAŻNE: Przyciski pomocnicze/drugorzędne mogą pozostać w widokach, ale główne 
             akcje (Zapisz, Generuj, Anuluj, itp.) należy ZAWSZE umieszczać w tym panelu 
             dla jednolitego wyglądu, zachowania i dostępności. -->
        <Grid x:Name="ActionButtonsPanel" Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{x:Bind ActionsLeft, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Center" ItemTemplateSelector="{StaticResource UiActionTemplateSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ActionsRight, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" ItemTemplateSelector="{StaticResource UiActionTemplateSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
        
        <!-- DOLNY PASEK STATUSU -->
        <Grid x:Name="BottomStatusBar" Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,0" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="20"/>
            </Grid.RenderTransform>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.EngineName, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PriorityOrder, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
                </Grid>
            </Border>
        </Grid>

        <!-- OVERLAY ŁADOWANIA -->
        <Grid x:Name="InitialLoadingOverlay" Grid.RowSpan="5" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Ładowanie aplikacji..." FontSize="16" HorizontalAlignment="Center" Opacity="0.8"/>
            </StackPanel>
        </Grid>

        <ContentPresenter x:Name="StartupOverlayContent" Grid.RowSpan="5" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ContentPresenter x:Name="LoginOverlay" Grid.RowSpan="5" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>