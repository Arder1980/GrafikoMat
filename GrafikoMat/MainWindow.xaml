<Window
    x:Class="GrafikoMat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto,Auto" Background="Transparent">
        <!-- 1) TOPBAR -->
        <Grid Grid.Row="0" x:Name="TopBarRow" ColumnDefinitions="*" Padding="12,6" Margin="0,0,140,0">
            <Grid x:Name="DragBar" VerticalAlignment="Center">
                <TextBlock Text="GrafikoMat Dyżurowy" FontSize="16" FontWeight="SemiBold" Opacity="0.92"/>
            </Grid>
        </Grid>

        <!-- 2) DANE JEDNOSTKI -->
        <Grid Grid.Row="1" Padding="12,10" MinHeight="100">
            <TextBlock Text="{x:Bind ViewModel.UnitName, Mode=OneWay}" FontSize="14" Opacity="0.9" TextWrapping="WrapWholeWords"/>
        </Grid>

        <!-- 3) VIEWPORT -->
        <Grid Grid.Row="2" Padding="12,8,12,8">
            <Border BorderBrush="#1A000000" BorderThickness="1" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <ContentPresenter x:Name="ViewportPresenter"/>
            </Border>
        </Grid>

        <!-- 4) PASEK AKCJI (ItemsControl z ItemsSource) -->
        <Grid Grid.Row="3" Padding="12,8">
            <ItemsControl ItemsSource="{x:Bind Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Command="{Binding Command}"
                                Margin="8,0,0,0"
                                MinWidth="140"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 5) STOPKA -->
        <Grid Grid.Row="4" Padding="12,6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
            <TextBlock Text="{x:Bind ViewModel.EngineName, Mode=OneWay}" Opacity="0.8"/>
            <Border Grid.Column="1" Width="1" Background="#22000000"/>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PriorityOrder, Mode=OneWay}" Opacity="0.8"/>
        </Grid>
    </Grid>
</Window>
