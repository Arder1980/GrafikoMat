<Window
    x:Class="GrafikoMat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="12">
        <!-- Zasoby lokalne muszą być na elemencie wizualnym (np. Grid), nie na Window -->
        <Grid.Resources>
            <!-- Delikatna szarość do obramowań -->
            <SolidColorBrush x:Key="BorderBrushNeutral" Color="#33000000"/>
        </Grid.Resources>

        <!-- Pasek górny: jednostka + rok/miesiąc -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <TextBlock Text="Jednostka: (ustaw w Ustawieniach)"
                       FontSize="18" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Rok:" VerticalAlignment="Center"/>
                <ComboBox Width="100" SelectedIndex="0">
                    <ComboBoxItem Content="2025"/>
                    <ComboBoxItem Content="2026"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Miesiąc:" VerticalAlignment="Center"/>
                <ComboBox Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="Styczeń"/>
                    <ComboBoxItem Content="Luty"/>
                    <ComboBoxItem Content="Marzec"/>
                    <ComboBoxItem Content="Kwiecień"/>
                    <ComboBoxItem Content="Maj"/>
                    <ComboBoxItem Content="Czerwiec"/>
                    <ComboBoxItem Content="Lipiec"/>
                    <ComboBoxItem Content="Sierpień"/>
                    <ComboBoxItem Content="Wrzesień"/>
                    <ComboBoxItem Content="Październik"/>
                    <ComboBoxItem Content="Listopad"/>
                    <ComboBoxItem Content="Grudzień"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Główna część: lewy panel 3/4, prawy 1/4 -->
        <Grid Grid.Row="1" ColumnDefinitions="3*,*" ColumnSpacing="12">
            <!-- LEWY panel: pasywna tabela deklaracji + przyciski -->
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Text="Deklaracje dyżurowe (pasywna tabela)"
                           FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer>
                        <Grid x:Name="LeftMatrixHost" Padding="12">
                            <TextBlock Text="Tutaj pojawi się tabela: wiersze = dyżurni, kolumny = dni miesiąca (święta wyszarzone, symbole jednoliterowe)."
                                       TextWrapping="Wrap" Opacity="0.75"/>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" HorizontalAlignment="Left">
                    <Button Content="Dodaj deklaracje dyżurowe" />
                    <Button Content="Zarządzanie dyżurnymi" />
                    <Button Content="Generuj grafik" />
                    <Button Content="Eksportuj..." />
                </StackPanel>
            </Grid>

            <!-- PRAWY panel: tabela „Data / Ustalony dyżurny” -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <TextBlock Text="Wygenerowany grafik" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer>
                        <StackPanel Padding="12" Spacing="4">
                            <!-- Nagłówek kolumn -->
                            <Grid ColumnDefinitions="2*,3*" Padding="0,0,0,6">
                                <TextBlock Text="Data" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Ustalony dyżurny" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Martwe wiersze przykładowe -->
                            <Grid ColumnDefinitions="2*,3*">
                                <TextBlock Text="01 (Pon)"/>
                                <TextBlock Grid.Column="1" Text="—"/>
                            </Grid>
                            <Grid ColumnDefinitions="2*,3*">
                                <TextBlock Text="02 (Wto)"/>
                                <TextBlock Grid.Column="1" Text="—"/>
                            </Grid>
                            <Grid ColumnDefinitions="2*,3*">
                                <TextBlock Text="03 (Śro) [Święto]" Opacity="0.75"/>
                                <TextBlock Grid.Column="1" Text="—" Opacity="0.75"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
