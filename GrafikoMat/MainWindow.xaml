<Window
    x:Class="GrafikoMat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GrafikoMat"
    xmlns:models="using:GrafikoMat.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <local:BooleanToPrimaryStyleConverter x:Key="BooleanToPrimaryStyleConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="UnitSelectionPanel" Grid.Row="1" Padding="12,8" MinHeight="100" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevUnitButton" Grid.Column="0" Content="&#xE0E2;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" Command="{x:Bind ViewModel.SwitchToPreviousUnitCommand}" ToolTipService.ToolTip="Poprzednia jednostka"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ActiveUnitHospitalName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.ActiveUnitDepartmentName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <Button x:Name="NextUnitButton" Grid.Column="2" Content="&#xE0E3;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" Command="{x:Bind ViewModel.SwitchToNextUnitCommand}" ToolTipService.ToolTip="Następna jednostka"/>
        </Grid>

        <Grid x:Name="MainContentPanel" Grid.Row="2" Padding="12,8,12,4" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <Grid x:Name="ViewportGrid">
                <ContentControl x:Name="ViewportCurrent" Opacity="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentControl x:Name="ViewportNext" Opacity="0"/>
            </Grid>
        </Grid>

        <Grid x:Name="ActionButtonsPanel" Grid.Row="3" Padding="12,4,12,10" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl x:Name="ActionButtonsLeft" Grid.Column="0" ItemsSource="{x:Bind ActionsLeft}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:UiAction">
                        <Button Content="{x:Bind Label}" Command="{x:Bind Command}" Margin="0,0,6,0" MinHeight="28" MinWidth="128" Padding="12,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="ActionButtonsRight" Grid.Column="1" ItemsSource="{x:Bind ActionsRight}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:UiAction">
                        <Button Content="{x:Bind Label}" Command="{x:Bind Command}" Margin="6,0,0,0" MinHeight="28" MinWidth="128" Padding="12,6"
                                Style="{Binding IsPrimary, Converter={StaticResource BooleanToPrimaryStyleConverter}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid x:Name="BottomStatusBar" Grid.Row="4" Padding="10,4,10,12" ColumnSpacing="16" Background="Transparent" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="20"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.EngineName, Mode=OneWay}" Opacity="0.9" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PriorityOrder, Mode=OneWay}" Opacity="0.9" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="InitialLoadingOverlay" Grid.RowSpan="5" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Przygotowywanie zawartości..." FontSize="16" FontWeight="SemiBold" Opacity="0.9"/>
            </StackPanel>
        </Grid>

        <ContentControl x:Name="LoginOverlay" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.RowSpan="5"/>

        <ContentControl x:Name="StartupOverlayContent" Grid.RowSpan="5"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <Grid x:Name="TopBarRow" Grid.Row="0" Height="32" Background="Transparent" Padding="10,0,0,0" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <Grid.Resources>
                <MenuFlyout x:Key="TitleBarMenu" Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem Text="Pomoc" Click="HelpMenuItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE897;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="O programie" Click="AboutMenuItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="{Binding ViewModel.CurrentUserName, Mode=OneWay}" IsEnabled="False">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE779;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Wyloguj się" Click="SignOutMenuItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragBar" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="GrafikoMat Dyżurowy" FontSize="14" FontWeight="SemiBold" Opacity="0.92"/>
            </Grid>
            <Button Grid.Column="1" x:Name="TitleBarMenuButton" Width="46" Height="32" HorizontalAlignment="Right" ToolTipService.ToolTip="Menu" FlyoutBase.AttachedFlyout="{StaticResource TitleBarMenu}" Click="TitleBarMenuButton_Click" Style="{StaticResource SubtleButtonStyle}">
                <Button.Resources>
                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                </Button.Resources>
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="14"/>
            </Button>
        </Grid>
    </Grid>
</Window>