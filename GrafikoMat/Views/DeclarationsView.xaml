<UserControl
    x:Class="GrafikoMat.Views.DeclarationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:GrafikoMat.Controls"
    xmlns:vm="using:GrafikoMat.ViewModels"
    xmlns:data="using:GrafikoMat.Core.Data"
    xmlns:common="using:GrafikoMat.Common"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:DeclarationsViewModel}"
    x:Name="DeclarationsViewRoot">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CalendarCellBorderBrush" Color="#33000000"/>
                    <SolidColorBrush x:Key="CalendarCellHeaderSeparatorBrush" Color="#1A000000"/>
                    <x:Double x:Key="DayNightGlyphOpacity">0.25</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CalendarCellBorderBrush" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="CalendarCellHeaderSeparatorBrush" Color="#1AFFFFFF"/>
                    <x:Double x:Key="DayNightGlyphOpacity">0.06</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <common:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter"/>

            <!-- ✅ DODANE - Animacje overlaya -->
            <Storyboard x:Name="OverlayFadeInStoryboard">
                <DoubleAnimation Storyboard.TargetName="NoDoctorsOverlay"
                               Storyboard.TargetProperty="Opacity"
                               From="0.0"
                               To="1.0"
                               Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="OverlayFadeOutStoryboard">
                <DoubleAnimation Storyboard.TargetName="NoDoctorsOverlay"
                               Storyboard.TargetProperty="Opacity"
                               To="0.0"
                               Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Style TargetType="TextBlock" x:Key="SymbolTextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*"/>
            <ColumnDefinition Width="0.75*"/>
        </Grid.ColumnDefinitions>

        <!-- LEWA KOLUMNA -->
        <Grid x:Name="LeftColumnGrid" Grid.Column="0" RowSpacing="10" Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Spacer (margines górny) -->
                <RowDefinition Height="Auto"/>
                <!-- Wybór dyżurnego -->
                <RowDefinition Height="Auto"/>
                <!-- Limity -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Spacer żeby wyrównać z nagłówkiem kalendarza + dniami tygodnia -->
            <Grid Grid.Row="0" Height="54"/>

            <!-- Wybór dyżurnego -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.CanSwitchDoctors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="&#xE0E2;" FontFamily="Segoe MDL2 Assets" Command="{x:Bind ViewModel.SelectPrevDoctorCommand}" ToolTipService.ToolTip="Poprzedni lekarz"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Doctors, Mode=OneWay}" 
                              SelectedIndex="{x:Bind ViewModel.SelectedDoctorIndex, Mode=TwoWay}" 
                              MinWidth="240" 
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DoctorDeclarationViewModel">
                                <TextBlock Text="{x:Bind DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="&#xE0E3;" FontFamily="Segoe MDL2 Assets" Command="{x:Bind ViewModel.SelectNextDoctorCommand}" ToolTipService.ToolTip="Następny lekarz"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.CanSwitchDoctors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="Lekarz:" VerticalAlignment="Center" Opacity="0.9"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedDoctor.FullName, Mode=OneWay, FallbackValue='.'}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- Limity -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Limity:" VerticalAlignment="Center" Opacity="0.85"/>
                <TextBox Width="120" IsEnabled="False" PlaceholderText="wkrótce."/>
            </StackPanel>
        </Grid>

        <!-- PRAWA KOLUMNA -->
        <Grid Grid.Column="1" Padding="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Nagłówek -->
                <RowDefinition Height="Auto"/>
                <!-- Dni tygodnia -->
                <RowDefinition Height="*"/>
                <!-- Kalendarz -->
            </Grid.RowDefinitions>

            <!-- Nagłówek nad kalendarzem -->
            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.MonthHeader, Mode=OneWay}" 
                       FontSize="18" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       Margin="0,4,0,16"/>

            <!-- Dni tygodnia -->
            <Grid Grid.Row="1" Padding="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Poniedziałek" HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="1" Text="Wtorek" HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="2" Text="Środa" HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="3" Text="Czwartek" HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="4" Text="Piątek" HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="5" Text="Sobota" HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock Grid.Column="6" Text="Niedziela" HorizontalAlignment="Center" Opacity="0.6"/>
            </Grid>

            <!-- Kontener dla kalendarza z możliwością opacity NA CAŁOŚĆ -->
            <Grid Grid.Row="2">
                <!-- Wrapper z Opacity kontrolowanym dynamicznie w code-behind -->
                <Grid x:Name="CalendarWrapper"
                      IsHitTestVisible="{x:Bind ViewModel.HasDoctors, Mode=OneWay}">

                    <!-- Kalendarz -->
                    <GridView x:Name="CalendarGridView" 
                              ItemsSource="{x:Bind ViewModel.DayCells, Mode=OneWay}" 
                              SelectionMode="None" 
                              IsItemClickEnabled="False">
                        <GridView.RenderTransform>
                            <TranslateTransform X="0"/>
                        </GridView.RenderTransform>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:CalendarUniformGridPanel Columns="7" RowSpacing="4" ColumnSpacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayCell">
                                <!-- Border z tłem - ZAWSZE widoczny -->
                                <Border Background="{x:Bind EffectiveBackground, Mode=OneWay}" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- NAGŁÓWEK - tło ZAWSZE widoczne -->
                                        <Border Grid.Row="0" Background="{x:Bind EffectiveHeaderBackground, Mode=OneWay}" CornerRadius="4,4,0,0"/>

                                        <!-- Zawartość nagłówka - z Opacity zależną od InMonth -->
                                        <Grid Grid.Row="0" Padding="6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind DayNumber}" FontWeight="SemiBold" 
                                                      Foreground="{x:Bind DayNumberForeground, Mode=OneWay}" VerticalAlignment="Center"
                                                      Opacity="{x:Bind InMonth, Converter={StaticResource BooleanToOpacityConverter}, ConverterParameter=0.35;0.6}"/>

                                            <TextBlock Grid.Column="1" Text="{x:Bind HolidayName}" 
                                                      Visibility="{x:Bind HolidayVisibility, Mode=OneWay}" 
                                                      FontSize="11" 
                                                      Foreground="{x:Bind DayNumberForeground, Mode=OneWay}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                                      Opacity="{x:Bind InMonth, Converter={StaticResource BooleanToOpacityConverter}, ConverterParameter=0.35;0.6}"/>
                                        </Grid>

                                        <!-- CONTENT (SLOTY) -->
                                        <Grid Grid.Row="1" MinHeight="48">
                                            <!-- SLOT 24h -->
                                            <Grid Visibility="{x:Bind IsSplit, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <!-- Glify TYLKO dla dni w miesiącu -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                                            Visibility="{x:Bind InMonth, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Viewbox MaxHeight="24" MaxWidth="24">
                                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE706;" Opacity="{ThemeResource DayNightGlyphOpacity}" IsHitTestVisible="False"/>
                                                    </Viewbox>
                                                    <TextBlock Text="+" FontSize="26" Opacity="{ThemeResource DayNightGlyphOpacity}" VerticalAlignment="Center" Margin="0,-10,0,0" IsHitTestVisible="False" FontWeight="Normal"/>
                                                    <Viewbox MaxHeight="22" MaxWidth="22">
                                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE708;" Opacity="{ThemeResource DayNightGlyphOpacity}" IsHitTestVisible="False"/>
                                                    </Viewbox>
                                                </StackPanel>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2" MaxWidth="180">
                                                    <TextBlock Style="{StaticResource SymbolTextBlock}" Text="{x:Bind DisplaySymbolFull, Mode=OneWay}"/>
                                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="None">
                                                        <Run Text="{x:Bind CoDutyPartnerFull, Mode=OneWay}" FontSize="9"/>
                                                        <Run Text=" " FontSize="9"/>
                                                        <Run Text="{x:Bind CoDutyStatusGlyphFull, Mode=OneWay}" FontSize="11"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- SLOTY 12h -->
                                            <Grid Visibility="{x:Bind IsSplit, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Viewbox Grid.Row="0" MaxHeight="24" MaxWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Visibility="{x:Bind InMonth, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE706;" Opacity="{ThemeResource DayNightGlyphOpacity}" IsHitTestVisible="False"/>
                                                </Viewbox>
                                                <Viewbox Grid.Row="1" MaxHeight="22" MaxWidth="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Visibility="{x:Bind InMonth, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE708;" Opacity="{ThemeResource DayNightGlyphOpacity}" IsHitTestVisible="False"/>
                                                </Viewbox>
                                                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{ThemeResource CalendarCellHeaderSeparatorBrush}"/>

                                                <!-- DAY SLOT -->
                                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1" MaxWidth="180">
                                                    <TextBlock Style="{StaticResource SymbolTextBlock}" Text="{x:Bind DisplaySymbolDay, Mode=OneWay}"/>
                                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="None">
                                                        <Run Text="{x:Bind CoDutyPartnerDay, Mode=OneWay}" FontSize="7"/>
                                                        <Run Text=" " FontSize="7"/>
                                                        <Run Text="{x:Bind CoDutyStatusGlyphDay, Mode=OneWay}" FontSize="9"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- NIGHT SLOT -->
                                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1" MaxWidth="180">
                                                    <TextBlock Style="{StaticResource SymbolTextBlock}" Text="{x:Bind DisplaySymbolNight, Mode=OneWay}"/>
                                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="None">
                                                        <Run Text="{x:Bind CoDutyPartnerNight, Mode=OneWay}" FontSize="7"/>
                                                        <Run Text=" " FontSize="7"/>
                                                        <Run Text="{x:Bind CoDutyStatusGlyphNight, Mode=OneWay}" FontSize="9"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- RAMKI - ZAWSZE widoczne -->
                                        <Border Grid.Row="0" BorderBrush="{x:Bind EffectiveBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="4,4,0,0"/>
                                        <Border Grid.Row="1" BorderBrush="{x:Bind EffectiveBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="0,0,4,4"/>

                                        <!-- ZAZNACZENIA -->
                                        <Border Grid.Row="1" BorderBrush="#FF3399FF" CornerRadius="0,0,4,4" BorderThickness="4"
                                                Visibility="{x:Bind IsFullSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <Grid Grid.Row="1" Visibility="{x:Bind IsSplit, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" BorderBrush="#FF3399FF" CornerRadius="0"
                                                    BorderThickness="{x:Bind DaySelectionBorderThickness, Mode=OneWay}"
                                                    Visibility="{x:Bind IsDaySelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <Border Grid.Row="1" BorderBrush="#FF3399FF" CornerRadius="0,0,4,4"
                                                    BorderThickness="{x:Bind NightSelectionBorderThickness, Mode=OneWay}"
                                                    Visibility="{x:Bind IsNightSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <!-- ✅ InfoBox z nazwą i początkową Opacity=0 -->
                <Grid x:Name="NoDoctorsOverlay"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MinWidth="340"
                      MaxWidth="500"
                      Opacity="0"
                      Visibility="{x:Bind ViewModel.HasNoDoctors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                          Padding="0"
                          CornerRadius="10">

                        <!-- Miękki cień -->
                        <Grid.Shadow>
                            <ThemeShadow/>
                        </Grid.Shadow>

                        <!-- Subtelna ramka w kolorze systemowym -->
                        <Border BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                CornerRadius="10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lewy pasek koloru - BURSZTYNOWY -->
                            <Border Grid.Column="0"
                                    Background="#FFB900"
                                    CornerRadius="10,0,0,10"/>

                            <!-- Ikona (wycentrowana) - BURSZTYNOWA -->
                            <Grid Grid.Column="1" 
                                  Width="64" 
                                  Margin="16,16,16,16">
                                <Viewbox Width="60" Height="60">
                                    <FontIcon Glyph="&#xE7BA;" 
                                              Foreground="#FFB900"/>
                                </Viewbox>
                            </Grid>

                            <!-- Treść -->
                            <StackPanel Grid.Column="2" 
                                        Margin="8,20,24,20"
                                        Spacing="8">
                                <TextBlock Text="Brak przypisanych dyżurnych"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Opacity="0.85"
                                           FontSize="14">
                                    Do tej jednostki nie są przypisani żadni dyżurni. Aby móc dodawać deklaracje, przejdź do zakładki 'Zarządzanie dyżurnymi' i przypisz lekarzy do tej jednostki.
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>