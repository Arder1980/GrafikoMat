<UserControl
    x:Class="GrafikoMat.Views.DeclarationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:GrafikoMat.Controls"
    xmlns:vm="using:GrafikoMat.ViewModels"
    xmlns:data="using:GrafikoMat.Core.Data"
    xmlns:common="using:GrafikoMat.Common"
    mc:Ignorable="d"
    x:DataType="vm:DeclarationsViewModel"
    d:DataContext="{d:DesignInstance Type=vm:DeclarationsViewModel}"
    x:Name="DeclarationsViewRoot">

    <UserControl.Resources>
        <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="TextBlock" x:Key="SymbolTextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid ColumnDefinitions="0.25*,0.75*" Padding="12" ColumnSpacing="12">

        <!-- Lewa kolumna -->
        <Grid x:Name="LeftColumnGrid" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2"
                       Text="{x:Bind ViewModel.MonthHeader, Mode=OneWay}"/>

            <Grid Grid.Row="1">
                <!-- Widok dla admina (może przełączać lekarzy) -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.CanSwitchDoctors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="&#xE0E2;" FontFamily="Segoe MDL2 Assets"
                            Command="{x:Bind ViewModel.SelectPrevDoctorCommand}"
                            ToolTipService.ToolTip="Poprzedni lekarz"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Doctors, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedDoctorIndex, Mode=TwoWay}"
                              MinWidth="180" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="data:DoctorProfile">
                                <TextBlock Text="{x:Bind FullName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="&#xE0E3;" FontFamily="Segoe MDL2 Assets"
                            Command="{x:Bind ViewModel.SelectNextDoctorCommand}"
                            ToolTipService.ToolTip="Następny lekarz"/>
                </StackPanel>

                <!-- Widok dla nie-admina (tylko podgląd) -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.CanSwitchDoctors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="Lekarz:" VerticalAlignment="Center" Opacity="0.9"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedDoctor.FullName, Mode=OneWay, FallbackValue='.'}"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Limity:" VerticalAlignment="Center" Opacity="0.85"/>
                <TextBox Width="120" IsEnabled="False" PlaceholderText="wkrótce."/>
            </StackPanel>
        </Grid>

        <!-- Prawa kolumna: siatka kalendarza -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <Grid Padding="0,0,0,4" ColumnDefinitions="*,*,*,*,*,*,*">
                <TextBlock Grid.Column="0" Text="Poniedziałek" HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="1" Text="Wtorek"       HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="2" Text="Środa"        HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="3" Text="Czwartek"     HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="4" Text="Piątek"       HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Grid.Column="5" Text="Sobota"       HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock Grid.Column="6" Text="Niedziela"    HorizontalAlignment="Center" Opacity="0.6"/>
            </Grid>

            <ItemsControl x:Name="CalendarItemsControl" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.DayCells, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:CalendarUniformGridPanel Columns="7" RowSpacing="4" ColumnSpacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <!-- Uwaga: to jest DataTemplate typowany na DayCell, więc x:Bind odnosi się do właściwości DayCell -->
                    <DataTemplate x:DataType="vm:DayCell">
                        <Border IsHitTestVisible="{x:Bind IsInteractive, Mode=OneWay}"
                                PointerPressed="Cell_PointerPressed"
                                PointerMoved="Cell_PointerMoved"
                                PointerReleased="Cell_PointerReleased"
                                RightTapped="OnCellRightTapped"
                                Background="{x:Bind Background, Mode=OneWay}"
                                BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4,4,0,0"/>

                                <Grid Grid.Row="0" Padding="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DayNumber}"
                                               FontWeight="SemiBold"
                                               Opacity="{x:Bind HeaderOpacity}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind HolidayName}"
                                               Visibility="{x:Bind HolidayVisibility, Mode=OneWay}"
                                               FontSize="11" Opacity="0.8"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <TextBlock Style="{StaticResource SymbolTextBlock}"
                                               Text="{x:Bind SymbolFull, Mode=OneWay}"
                                               Visibility="{x:Bind IsSplit, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                                    <Grid Visibility="{x:Bind IsSplit, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          RowDefinitions="*,*">
                                        <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Style="{StaticResource SymbolTextBlock}" Text="{x:Bind SymbolDay, Mode=OneWay}"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SymbolTextBlock}" Text="{x:Bind SymbolNight, Mode=OneWay}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
