<UserControl
    x:Class="GrafikoMat.Views.DeclarationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    UseLayoutRounding="True">

    <Grid ColumnDefinitions="0.25*,0.75*" Padding="12" ColumnSpacing="12">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2">
                <Run Text="Deklaracje dyżurowe na "/>
                <Run x:Name="MonthRun" Text="(miesiąc)"/>
            </TextBlock>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Lekarz:" VerticalAlignment="Center" Opacity="0.9"/>
                <ComboBox x:Name="DoctorsCombo"
                          MinWidth="200"
                          SelectionChanged="OnDoctorSelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Limity:" VerticalAlignment="Center" Opacity="0.85"/>
                <TextBox Width="120" PlaceholderText="np. 10 nocy"/>
            </StackPanel>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
                <Button Content="Zapisz" Click="OnSaveClick"/>
                <Button Grid.Column="1" Content="Zapisz i zamknij" Click="OnSaveAndCloseClick"/>
            </Grid>
        </Grid>

        <Grid x:Name="CalendarGridHost" Grid.Column="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />

    </Grid>
</UserControl>