<UserControl
    x:Class="GrafikoMat.Views.ManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GrafikoMat.ViewModels"
    xmlns:data="using:GrafikoMat.Core.Data"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Icon="Add" Label="Nowy dyżurny" Command="{x:Bind ViewModel.AddNewDoctorCommand}"/>
                <AppBarButton Icon="Delete" Label="Usuń"/>
            </CommandBar>

            <TextBox Grid.Row="1" 
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Filtruj listę..."
                     Margin="8,0,8,8"/>

            <ListView Grid.Row="2"
                      BorderThickness="0,1,1,0"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      ItemsSource="{x:Bind ViewModel.FilteredDoctors}"
                      SelectedItem="{x:Bind ViewModel.SelectedDoctor, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:DoctorProfile">
                        <TextBlock Margin="12,10" 
                                   Style="{ThemeResource BaseTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind FullName}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" Padding="24">
            <Grid>
                <Grid Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <ProgressRing IsActive="True" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.EditorViewModel, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay, ConverterParameter=Inverse}">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" FontSize="48" Opacity="0.5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Wybierz dyżurnego z listy lub dodaj nowego." Margin="0,12,0,0"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Visibility="{x:Bind ViewModel.EditorViewModel, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                <StackPanel Spacing="12">

                    <TextBlock Text="Dane dyżurnego" Style="{ThemeResource TitleTextBlockStyle}"/>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.7*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Imię:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.EditorViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="NameTextBox_LostFocus"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Nazwisko:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.EditorViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="NameTextBox_LostFocus"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Skrót:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="5" Text="{x:Bind ViewModel.EditorViewModel.Abbreviation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{x:Bind ViewModel.EditorViewModel.AbbreviationErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemErrorTextColor}" FontSize="12"/>

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{x:Bind ViewModel.EditorViewModel.NameErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemErrorTextColor}" FontSize="12"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="E-mail:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.EditorViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.EditorViewModel.EmailErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemErrorTextColor}" FontSize="12"/>

                        <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4">
                            <Grid Visibility="{x:Bind ViewModel.EditorViewModel.ShowPasswordSection, Mode=OneWay}" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hasło startowe:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.EditorViewModel.Password, Mode=OneWay}" IsReadOnly="True"/>
                                <Button Grid.Column="2" Content="Kopiuj" Click="CopyPassword_Click"/>
                            </Grid>

                            <Button Content="Resetuj hasło użytkownika..."
                                    Command="{x:Bind ViewModel.ResetPasswordCommand}"
                                    Visibility="{x:Bind ViewModel.EditorViewModel.ShowResetButton, Mode=OneWay}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </Grid>

                    <CheckBox Content="Administrator Systemu" IsChecked="{x:Bind ViewModel.EditorViewModel.Profile.IsAdmin, Mode=TwoWay}" Margin="0,12,0,0"/>

                    <TextBlock Text="Przypisania i Aktywność" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,24,0,0"/>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.EditorViewModel.Assignments, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnitAssignmentViewModel">
                                <Grid Margin="0,8" Padding="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{x:Bind IsAssigned, Mode=TwoWay}"
                                              IsEnabled="{x:Bind CanBeChanged, Mode=OneWay}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind UnitName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind DepartmentName}" FontSize="12" Opacity="0.8"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <ToggleSwitch Grid.Column="1" Header="Aktywna" IsOn="{x:Bind IsActive, Mode=TwoWay}" IsEnabled="{x:Bind IsAssigned, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <controls:InfoBar
                        x:Name="StatusInfoBar"
                        Title="{x:Bind ViewModel.StatusMessageTitle, Mode=OneWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        IsOpen="{x:Bind ViewModel.IsStatusMessageOpen, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.StatusMessageSeverity, Mode=OneWay}"
                        CornerRadius="4"
                        Margin="0,12,0,0"/>

                    <Button Content="Zapisz zmiany"
                            Command="{x:Bind ViewModel.SaveDoctorCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>