<UserControl
    x:Class="GrafikoMat.Views.Settings.EngineSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GrafikoMat.ViewModels"
    xmlns:models="using:GrafikoMat.Core.Scheduling.Models"
    xmlns:common="using:GrafikoMat.Common"
    mc:Ignorable="d">

    <UserControl.Resources>
        <common:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <common:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Padding="20,20,20,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DetailsStateGroup">
                <VisualState x:Name="DetailsCollapsed">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsBorder" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="DetailsBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="DetailsBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-10" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="DetailsVisible">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsBorder" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="DetailsBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="DetailsBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SettingsStateGroup">
                <VisualState x:Name="SettingsCollapsed">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SettingsBorder" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="SettingsBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="SettingsBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-10" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="SettingsVisible">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SettingsBorder" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="SettingsBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="SettingsBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Silnik Obliczeniowy" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel Spacing="16">

                <TextBlock Text="Wybierz algorytm, który będzie używany do generowania grafików."
                           TextWrapping="Wrap" Opacity="0.8"/>

                <!-- TABELA PORÓWNAWCZA SILNIKÓW -->
                <ListView
                  ItemsSource="{x:Bind ViewModel.EngineOptions}"
                  SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="4"
                  VerticalAlignment="Top">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2.6*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Nazwa silnika" FontWeight="SemiBold" HorizontalAlignment="Left"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="Typ algorytmu" FontWeight="SemiBold"/>
                                    <FontIcon Glyph="&#xE946;"
                                              FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center">
                                        <ToolTipService.ToolTip>
                                            <ToolTip MaxWidth="600">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run FontWeight="Bold">Algorytm przeszukiwania zupełnego:</Run><LineBreak/>
                                                    <Run>przeszukuje całą przestrzeń rozwiązań, gwarantując znalezienie optimum.</Run><LineBreak/><LineBreak/>
                                                    <Run FontWeight="Bold">Algorytm przeszukiwania heurystycznego:</Run><LineBreak/>
                                                    <Run>inteligentnie wybiera ścieżki, dążąc do optimum.</Run><LineBreak/><LineBreak/>
                                                    <Run FontWeight="Bold">Metaheurystyka:</Run><LineBreak/>
                                                    <Run>technika optymalizacji, która znajduje bardzo dobre rozwiązania w rozsądnym czasie, bez gwarancji optimum.</Run>
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </FontIcon>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="Rodzaj" FontWeight="SemiBold"/>
                                    <FontIcon Glyph="&#xE946;"
                                              FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center">
                                        <ToolTipService.ToolTip>
                                            <ToolTip MaxWidth="400">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run FontWeight="Bold">Deterministyczny:</Run><LineBreak/>
                                                    <Run>ten sam wynik dla tych samych danych wejściowych.</Run><LineBreak/><LineBreak/>
                                                    <Run FontWeight="Bold">Stochastyczny:</Run><LineBreak/>
                                                    <Run>zawiera element losowości.</Run>
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </FontIcon>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="Wielowątkowość" FontWeight="SemiBold"/>
                                    <FontIcon Glyph="&#xE946;"
                                              FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center">
                                        <ToolTipService.ToolTip>
                                            <ToolTip MaxWidth="400">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run FontWeight="Bold">Tak:</Run><LineBreak/>
                                                    <Run>algorytm wykorzystuje wiele rdzeni procesora, co przyspiesza obliczenia.</Run><LineBreak/><LineBreak/>
                                                    <Run FontWeight="Bold">Nie:</Run><LineBreak/>
                                                    <Run>obliczenia są wykonywane sekwencyjnie na jednym rdzeniu.</Run>
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </FontIcon>
                                </StackPanel>

                                <TextBlock Grid.Column="4" Text="Jakość wyniku" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Czas obliczeń" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EngineOption">
                            <Grid Padding="0,10,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2.6*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0" GroupName="EngineSelection" Content="{x:Bind Name}" Checked="EngineRadioButton_Checked" IsChecked="{x:Bind IsSelected, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind AlgorithmType}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Determinism}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind Multithreading}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind QualityGuarantee}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind TimeToResult}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- CHARAKTERYSTYKA WYBRANEGO SILNIKA -->
                <Border x:Name="DetailsBorder" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12,8" CornerRadius="4,4,0,0">
                            <TextBlock Text="Charakterystyka wybranego silnika" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.SelectedEngine.Description, Mode=OneWay, FallbackValue=''}"
                                   TextWrapping="Wrap" LineHeight="22" TextAlignment="Justify" Opacity="0.9" Padding="12">
                            <TextBlock.Transitions>
                                <TransitionCollection>
                                    <ContentThemeTransition/>
                                </TransitionCollection>
                            </TextBlock.Transitions>
                        </TextBlock>
                    </Grid>
                </Border>
                <!-- USTAWIENIA PARAMETRÓW WYBRANEGO SILNIKA -->
                <Border x:Name="SettingsBorder" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12,8" CornerRadius="4,4,0,0">
                            <TextBlock Text="Ustawienia wybranego silnika" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Grid.Row="1" Spacing="16" Padding="12">
                            <StackPanel.Transitions>
                                <TransitionCollection>
                                    <ContentThemeTransition/>
                                </TransitionCollection>
                            </StackPanel.Transitions>

                            <!-- SIMULATED ANNEALING -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedEngine.Type, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SimulatedAnnealing}">
                                <Slider Minimum="{x:Bind ViewModel.CoolingRateMin}" 
                                        Maximum="{x:Bind ViewModel.CoolingRateMax}" 
                                        StepFrequency="{x:Bind ViewModel.CoolingRateStep}" 
                                        Value="{x:Bind ViewModel.CoolingRateValue, Mode=TwoWay}">
                                    <Slider.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Tempo schładzania"/>
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="400">
                                                        <TextBlock TextWrapping="Wrap">
                                                            Określa, jak szybko algorytm staje się "wybredny".<LineBreak/><LineBreak/>
                                                            <Run FontWeight="Bold">Niższa wartość (lewo):</Run> szybsze obliczenia, ale większe ryzyko utknięcia w lokalnym optimum (niższa jakość).<LineBreak/>
                                                            <Run FontWeight="Bold">Wyższa wartość (prawo):</Run> dłuższe obliczenia, ale większa szansa na znalezienie globalnie lepszego rozwiązania (wyższa jakość).
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                    </Slider.Header>
                                </Slider>
                                <Button Content="Przywróć ustawienia domyślne" Command="{x:Bind ViewModel.ResetSimulatedAnnealingCommand}" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- GENETIC ALGORITHM -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedEngine.Type, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Genetic}">
                                <Slider Minimum="{x:Bind ViewModel.GeneticPopulationSizeMin}" 
                                        Maximum="{x:Bind ViewModel.GeneticPopulationSizeMax}" 
                                        StepFrequency="{x:Bind ViewModel.GeneticPopulationSizeStep}" 
                                        Value="{x:Bind ViewModel.GeneticPopulationSizeValue, Mode=TwoWay}">
                                    <Slider.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Rozmiar populacji"/>
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="400">
                                                        <TextBlock TextWrapping="Wrap">
                                                            Liczba osobników (kandydatów rozwiązań) w każdej generacji.<LineBreak/><LineBreak/>
                                                            <Run FontWeight="Bold">Większa wartość:</Run> większa różnorodność genetyczna, lepsza eksploracja przestrzeni rozwiązań, ale wolniejsze obliczenia.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                    </Slider.Header>
                                </Slider>
                                <Slider Minimum="{x:Bind ViewModel.GeneticGenerationsMin}" 
                                        Maximum="{x:Bind ViewModel.GeneticGenerationsMax}" 
                                        StepFrequency="{x:Bind ViewModel.GeneticGenerationsStep}" 
                                        Value="{x:Bind ViewModel.GeneticGenerationsValue, Mode=TwoWay}">
                                    <Slider.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Liczba generacji"/>
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="400">
                                                        <TextBlock TextWrapping="Wrap">
                                                            Ile razy populacja przejdzie proces ewolucji (selekcja, krzyżowanie, mutacja).<LineBreak/><LineBreak/>
                                                            <Run FontWeight="Bold">Większa wartość:</Run> więcej czasu na 'wyhodowanie' lepszych rozwiązań, ale dłuższy czas obliczeń.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                    </Slider.Header>
                                </Slider>
                                <Button Content="Przywróć ustawienia domyślne" Command="{x:Bind ViewModel.ResetGeneticCommand}" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- ANT COLONY -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedEngine.Type, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AntColony}">
                                <Slider Minimum="{x:Bind ViewModel.AntColonyAntsMin}" 
                                        Maximum="{x:Bind ViewModel.AntColonyAntsMax}" 
                                        StepFrequency="{x:Bind ViewModel.AntColonyAntsStep}" 
                                        Value="{x:Bind ViewModel.AntColonyAntsValue, Mode=TwoWay}">
                                    <Slider.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Liczba mrówek"/>
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="400">
                                                        <TextBlock TextWrapping="Wrap">
                                                            Liczba agentów (mrówek) konstruujących rozwiązania w każdej generacji.<LineBreak/><LineBreak/>
                                                            <Run FontWeight="Bold">Większa wartość:</Run> szersze pokrycie przestrzeni rozwiązań, ale wolniejsze obliczenia.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                    </Slider.Header>
                                </Slider>
                                <Slider Minimum="{x:Bind ViewModel.AntColonyGenerationsMin}" 
                                        Maximum="{x:Bind ViewModel.AntColonyGenerationsMax}" 
                                        StepFrequency="{x:Bind ViewModel.AntColonyGenerationsStep}" 
                                        Value="{x:Bind ViewModel.AntColonyGenerationsValue, Mode=TwoWay}">
                                    <Slider.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Liczba generacji"/>
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="400">
                                                        <TextBlock TextWrapping="Wrap">
                                                            Ile razy kolonia mrówek przejdzie cykl konstrukcji i wzmocnienia feromonowego.<LineBreak/><LineBreak/>
                                                            <Run FontWeight="Bold">Większa wartość:</Run> silniejsza konwergencja w kierunku najlepszych tras, ale dłuższy czas obliczeń.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                    </Slider.Header>
                                </Slider>
                                <Button Content="Przywróć ustawienia domyślne" Command="{x:Bind ViewModel.ResetAntColonyCommand}" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- TABU SEARCH -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedEngine.Type, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TabuSearch}">
                                <Slider Minimum="{x:Bind ViewModel.TabuListSizeMin}" 
                                        Maximum="{x:Bind ViewModel.TabuListSizeMax}" 
                                        StepFrequency="{x:Bind ViewModel.TabuListSizeStep}" 
                                        Value="{x:Bind ViewModel.TabuListSizeValue, Mode=TwoWay}">
                                    <Slider.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Rozmiar listy tabu"/>
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="400">
                                                        <TextBlock TextWrapping="Wrap">
                                                            Jak długo algorytm "pamięta", aby nie wracać do niedawno sprawdzonych rozwiązań.<LineBreak/><LineBreak/>
                                                            <Run FontWeight="Bold">Większa wartość:</Run> większa dywersyfikacja (unikanie lokalnych optimów), ale może spowalniać zbieżność.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                    </Slider.Header>
                                </Slider>
                                <Slider Minimum="{x:Bind ViewModel.TabuMaxIterationsMin}" 
                                        Maximum="{x:Bind ViewModel.TabuMaxIterationsMax}" 
                                        StepFrequency="{x:Bind ViewModel.TabuMaxIterationsStep}" 
                                        Value="{x:Bind ViewModel.TabuMaxIterationsValue, Mode=TwoWay}">
                                    <Slider.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Maksymalna liczba iteracji"/>
                                            <FontIcon Glyph="&#xE946;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Center">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="400">
                                                        <TextBlock TextWrapping="Wrap">
                                                            Całkowity czas działania algorytmu.<LineBreak/><LineBreak/>
                                                            <Run FontWeight="Bold">Większa wartość:</Run> więcej czasu na znalezienie lepszego rozwiązania, ale dłuższy czas obliczeń.
                                                        </TextBlock>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </FontIcon>
                                        </StackPanel>
                                    </Slider.Header>
                                </Slider>
                                <Button Content="Przywróć ustawienia domyślne" Command="{x:Bind ViewModel.ResetTabuSearchCommand}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>                