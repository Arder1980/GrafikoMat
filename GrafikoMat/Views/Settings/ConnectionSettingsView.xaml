<!-- GrafikoMat\Views\Settings\ConnectionSettingsView.xaml -->
<UserControl
    x:Class="GrafikoMat.Views.Settings.ConnectionSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:GrafikoMat.Controls"
    xmlns:common="using:GrafikoMat.Common"
    mc:Ignorable="d">

    <UserControl.Resources>
        <common:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <controls:ActionContainer x:Name="ActionContainer">
        <StackPanel Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Połączenie z Bazą Danych" FontSize="20" FontWeight="SemiBold"/>

            <TextBlock TextWrapping="Wrap">
                 Wprowadź tutaj dane połączeniowe do bazy danych GrafikoMat w Supabase.
            </TextBlock>

            <!-- Komunikat błędu (jeśli ErrorMessage nie jest null/empty) -->
            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    x:Name="ErrorBorder"
                    x:Load="False">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA39;"
                                  FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="Błąd połączenia" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorMessageTextBlock"
                               TextWrapping="Wrap" 
                               FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBox x:Name="UrlTextBox" Header="Supabase URL" Width="550"/>
            <TextBox x:Name="ApiKeyTextBox" Header="Supabase Anon Key" Width="550"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="TestButton"
                        Content="Testuj połączenie"
                        Click="TestButton_Click"
                        Visibility="{Binding IsInitialSetupMode, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}"/>
                <Button x:Name="SaveButton"
                        Content="Zapisz i kontynuuj"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </controls:ActionContainer>
</UserControl>
