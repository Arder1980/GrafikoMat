<UserControl
    x:Class="GrafikoMat.Views.Settings.ConnectionSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <StackPanel x:Name="MainPanel" Spacing="20">
            <TextBlock Text="Połączenie z Bazą Danych" FontSize="20" FontWeight="SemiBold"/>

            <TextBlock TextWrapping="Wrap">
                Wprowadź tutaj dane połączeniowe do Twojego projektu w Supabase. 
                Te ustawienia są globalne dla całej aplikacji.
            </TextBlock>

            <TextBox x:Name="UrlTextBox" Header="Supabase URL"/>
            <TextBox x:Name="ApiKeyTextBox" Header="Supabase Anon Key"/>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" MinHeight="72"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TestButton" 
                        Content="Testuj połączenie"
                        Click="TestButton_Click"/>
                <Button x:Name="SaveButton" 
                        Content="Zapisz i przeładuj"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>

        <ProgressRing x:Name="LoadingRing"
                      IsActive="False"
                      Width="64" Height="64"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</UserControl>