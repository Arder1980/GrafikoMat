<UserControl
    x:Class="GrafikoMat.Views.Settings.UnitsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:GrafikoMat.Core.Data"
    xmlns:common="using:GrafikoMat.Common"
    xmlns:controls="using:GrafikoMat.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <common:BooleanToOpacityConverter x:Key="ArchiveOpacityConverter" TrueValue="0.5" FalseValue="1.0" />
        <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <common:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <common:NullToVisibilityConverter x:Key="NullToCollapsedConverter" Invert="True"/>
        <common:NullToVisibilityConverter x:Key="NullToVisibleConverter" Invert="False"/>
        <common:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Storyboard dla fade out formularza -->
        <Storyboard x:Name="FormFadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="EditFormGrid"
                           Storyboard.TargetProperty="Opacity"
                           To="0.0"
                           Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Storyboard dla fade in formularza -->
        <Storyboard x:Name="FormFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="EditFormGrid"
                           Storyboard.TargetProperty="Opacity"
                           From="0.0"
                           To="1.0"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <controls:ActionContainer x:Name="ActionContainer">
        <Grid x:Name="MainContentGrid" Padding="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- NAGŁÓWEK -->
            <TextBlock Grid.Row="0" 
                       Text="Zarządzanie Jednostkami" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,16"/>

            <!-- GÓRNY WIERSZ: LISTA JEDNOSTEK -->
            <Grid x:Name="UnitsListGrid" Grid.Row="1" Margin="0,0,0,24">
                <Grid.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition/>
                    </TransitionCollection>
                </Grid.Transitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Pasek wyszukiwania i przycisków -->
                <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" 
                                 PlaceholderText="Szukaj jednostki..." 
                                 TextChanged="SearchBox_TextChanged"
                                 Padding="32,8,8,8"/>

                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" 
                                  Glyph="&#xE721;" 
                                  FontSize="16"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  IsHitTestVisible="False"/>
                    </Grid>

                    <CheckBox x:Name="ShowArchivedCheckBox" 
                              Grid.Column="1"
                              Content="Pokaż deaktywowane" 
                              Checked="ShowArchivedCheckBox_Changed" 
                              Unchecked="ShowArchivedCheckBox_Changed"
                              VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Dodaj nową jednostkę"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddNewButton_Click"/>
                </Grid>

                <!-- Tabela z obramowaniem -->
                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Nagłówek tabeli -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                           Text="Skrócona nazwa jednostki" 
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Opacity="0.8"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                           Text="Podjednostka (oddział, zakład)" 
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Opacity="0.8"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lista jednostek -->
                        <ListView x:Name="UnitsListView"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind DisplayedUnits}"
                                  SelectionMode="Single"
                                  SelectionChanged="UnitsListView_SelectionChanged"
                                  Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="data:Unit">
                                    <Grid Opacity="{x:Bind IsArchived, Converter={StaticResource ArchiveOpacityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{x:Bind Name}" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind DepartmentName}" 
                                                   VerticalAlignment="Center" 
                                                   Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <FontIcon Grid.Column="2"
                                                  FontFamily="{StaticResource SymbolThemeFontFamily}" 
                                                  Glyph="&#xE8D8;" 
                                                  FontSize="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                  ToolTipService.ToolTip="Deaktywowana"
                                                  Visibility="{x:Bind IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- SEPARATOR -->
            <Border Grid.Row="2" 
                    Height="1" 
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                    Margin="0,0,0,24"
                    Visibility="{x:Bind SelectedUnit, Converter={StaticResource NullToVisibleConverter}, Mode=OneWay}">
                <Border.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition/>
                    </TransitionCollection>
                </Border.Transitions>
            </Border>

            <!-- DOLNY WIERSZ: FORMULARZ EDYCJI -->
            <Grid x:Name="EditFormGrid" 
                  Grid.Row="3"
                  Opacity="0"
                  Visibility="{x:Bind SelectedUnit, Converter={StaticResource NullToVisibleConverter}, Mode=OneWay}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nagłówek formularza -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{x:Bind EditModeTitle, Mode=OneWay}" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Edytuj szczegóły jednostki poniżej" 
                                   Opacity="0.7" 
                                   FontSize="13"
                                   Visibility="{x:Bind IsEditMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="Wypełnij informacje o nowej jednostce" 
                                   Opacity="0.7" 
                                   FontSize="13"
                                   Visibility="{x:Bind IsEditMode, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Info o deaktywacji -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" 
                            BorderBrush="{ThemeResource SystemFillColorAttentionBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind IsArchived, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" 
                                      Glyph="&#xE7BA;" 
                                      FontSize="14"/>
                            <TextBlock Text="Jednostka deaktywowana" 
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Formularz w obramowaniu -->
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="HospitalNameTextBox" 
                                 Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                 Header="Pełna nazwa szpitala"
                                 Text="{x:Bind SelectedUnit.HospitalFullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="HospitalNameTextBox_TextChanged"
                                 KeyDown="HospitalNameTextBox_KeyDown"
                                 LostFocus="HospitalNameTextBox_LostFocus"
                                 IsEnabled="{x:Bind IsArchived, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>

                        <TextBox x:Name="DepartmentNameTextBox" 
                                 Grid.Row="1" Grid.Column="0"
                                 Header="Nazwa oddziału/zakładu"
                                 Text="{x:Bind SelectedUnit.DepartmentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind IsArchived, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>

                        <TextBox x:Name="NameTextBox" 
                                 Grid.Row="1" Grid.Column="1"
                                 Header="Nazwa skrócona (np. Szpital Miejski)"
                                 Text="{x:Bind SelectedUnit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind IsArchived, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8">
                            <CheckBox Content="Używaj domyślnie dyżurów 12-godzinnych (Dzień/Noc)"
                                      IsChecked="{x:Bind SelectedUnit.UseTwelveHourShiftsByDefault, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsArchived, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>

                            <CheckBox Content="Zezwalaj na teleradiologię jako zastępstwo przy braku obsady"
                                      IsChecked="{x:Bind SelectedUnit.AllowTeleradiologyFallback, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsArchived, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </controls:ActionContainer>
</UserControl>