<UserControl
    x:Class="GrafikoMat.Views.Settings.UnitsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:GrafikoMat.Core.Data"
    xmlns:common="using:GrafikoMat.Common"
    xmlns:controls="using:GrafikoMat.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <common:BooleanToOpacityConverter x:Key="ArchiveOpacityConverter" TrueValue="0.5" FalseValue="1.0" />

        <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <controls:ActionContainer x:Name="ActionContainer">
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Zarządzanie Jednostkami" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Grid Grid.Row="1" ColumnSpacing="20" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ShowArchivedCheckBox" 
                          Grid.Column="0"
                          Content="Pokaż zarchiwizowane" 
                          Checked="ShowArchivedCheckBox_Changed" 
                          Unchecked="ShowArchivedCheckBox_Changed"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="AddButton" Content="Dodaj nową..." HorizontalAlignment="Stretch" Click="AddButton_Click"/>
                    <Button x:Name="EditButton" Content="Edytuj..." HorizontalAlignment="Stretch" Click="EditButton_Click" IsEnabled="False"/>
                    <Button x:Name="ArchiveButton" Content="Archiwizuj" HorizontalAlignment="Stretch" Click="ArchiveButton_Click" IsEnabled="False"/>
                    <Button x:Name="RestoreButton" Content="Przywróć" HorizontalAlignment="Stretch" Click="RestoreButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <ListView Grid.Row="2"
                      x:Name="UnitsListView"
                      ItemsSource="{x:Bind DisplayedUnits}"
                      SelectionMode="Single"
                      SelectionChanged="UnitsListView_SelectionChanged"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:Unit">
                        <StackPanel Margin="12" Spacing="4" Opacity="{x:Bind IsArchived, Converter={StaticResource ArchiveOpacityConverter}}">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{x:Bind DepartmentName}" FontSize="14"/>
                            <TextBlock Opacity="0.7">
                                 <Run Text="{x:Bind HospitalFullName}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </controls:ActionContainer>
</UserControl>