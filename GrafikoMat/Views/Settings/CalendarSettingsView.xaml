<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GrafikoMat.Views.Settings.CalendarSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GrafikoMat.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="24" MaxWidth="900">

            <!-- NAGŁÓWEK -->
            <StackPanel Spacing="8">
                <TextBlock Text="Kalendarz i Dni Wolne"
                           Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="Zarządzaj feriami zimowymi i innymi dniami specjalnymi wyświetlanymi w kalendarzu deklaracji."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Opacity="0.7"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- WYBÓR JEDNOSTKI -->
            <StackPanel Spacing="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                <TextBlock Text="Ustawienia dla:"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <ComboBox x:Name="UnitComboBox"
                          ItemsSource="{x:Bind ViewModel.AvailableUnits, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedUnit, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          HorizontalAlignment="Stretch"
                          MinWidth="400"/>
                <TextBlock Text="Wybierz 'Globalne' aby ustawić domyślne wartości dla wszystkich jednostek, lub wybierz konkretną jednostkę aby nadpisać ustawienia globalne."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Opacity="0.6"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- FERIE ZIMOWE (zawsze widoczne) -->
            <StackPanel Spacing="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Ferie Zimowe"
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Określ termin ferii zimowych dla wybranego roku. Ferie będą wyświetlane w nagłówkach komórek kalendarza."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.6"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Wybór roku dla ferii -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.PreviousWinterYearCommand}"
                            Width="44"
                            Height="40"
                            ToolTipService.ToolTip="Poprzedni rok">
                        <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                    </Button>

                    <ComboBox x:Name="WinterYearComboBox"
                              ItemsSource="{x:Bind ViewModel.AvailableWinterYears, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedWinterYear, Mode=TwoWay}"
                              MinWidth="120"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                    <Button Command="{x:Bind ViewModel.NextWinterYearCommand}"
                            Width="44"
                            Height="40"
                            ToolTipService.ToolTip="Następny rok">
                        <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="12">
                    <!-- Wyświetlanie aktualnego zakresu -->
                    <TextBlock x:Name="WinterHolidayRangeText"
                               Text="{x:Bind ViewModel.WinterHolidayRangeText, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Kalendarz do wyboru soboty -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Wybierz sobotę rozpoczynającą ferie:"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <CalendarDatePicker x:Name="WinterStartDatePicker"
                                            Date="{x:Bind ViewModel.WinterHolidayStartDate, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}"
                                            MinDate="{x:Bind ViewModel.WinterMinDate, Mode=OneWay}"
                                            MaxDate="{x:Bind ViewModel.WinterMaxDate, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            DateFormat="{}{day.integer}.{month.integer}.{year.full}"
                                            PlaceholderText="Wybierz sobotę"
                                            Language="pl-PL"
                                            FirstDayOfWeek="Monday"
                                            CalendarIdentifier="GregorianCalendar"
                                            Opened="WinterDatePicker_Opened"
                                            CalendarViewDayItemChanging="WinterDatePicker_CalendarViewDayItemChanging"/>
                        <TextBlock Text="Tylko soboty mogą być wybrane. Koniec ferii zostanie automatycznie ustawiony na niedzielę 2 tygodnie później."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- INNE DNI SPECJALNE -->
            <StackPanel Spacing="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Inne Dni Specjalne"
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Dodaj niestandardowe dni specjalne (święta lokalne, odpusty, itp.). Nazwa może mieć maksymalnie 15 znaków widocznych, pełna nazwa będzie wyświetlana w tooltip."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.6"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Lista dni specjalnych -->
                <ListView x:Name="CustomDaysList"
                          ItemsSource="{x:Bind ViewModel.CustomSpecialDays, Mode=OneWay}"
                          SelectionMode="None"
                          MaxHeight="300">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpecialDayViewModel">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           ToolTipService.ToolTip="{x:Bind FullName}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DateRangeDisplay}"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"/>

                                <Button Grid.Column="2"
                                        Content="&#xE74D;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding DataContext.DeleteCustomDayCommand, ElementName=CustomDaysList}"
                                        CommandParameter="{x:Bind}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8"
                                        ToolTipService.ToolTip="Usuń"
                                        VerticalAlignment="Center">
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#D32F2F"/>
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#B71C1C"/>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Przycisk dodawania -->
                <Button Content="+ Dodaj dzień specjalny"
                        Command="{x:Bind ViewModel.AddCustomDayCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
