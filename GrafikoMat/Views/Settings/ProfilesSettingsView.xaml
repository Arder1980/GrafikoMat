<UserControl
    x:Class="GrafikoMat.Views.Settings.ProfilesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:GrafikoMat.Services"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Profile Jednostek" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="20">

            <ListView x:Name="ProfilesListView"
                      ItemsSource="{x:Bind Profiles}"
                      SelectionMode="Single"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:UnitProfile">
                        <StackPanel Margin="12" Spacing="4">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Opacity="0.7" FontSize="12">
                                <Run Text="Szpital: "/>
                                <Run Text="{x:Bind HospitalFullName}"/>
                            </TextBlock>
                            <TextBlock Opacity="0.7" FontSize="12">
                                <Run Text="Oddział: "/>
                                <Run Text="{x:Bind DepartmentName}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="AddButton" Content="Dodaj nowy..." HorizontalAlignment="Stretch" Click="AddButton_Click"/>
                <Button x:Name="EditButton" Content="Edytuj..." HorizontalAlignment="Stretch" Click="EditButton_Click"/>
                <Button x:Name="DeleteButton" Content="Usuń" HorizontalAlignment="Stretch" Click="DeleteButton_Click"/>

                <Border Height="20"/>

                <Button x:Name="SetActiveButton" 
                        Content="Ustaw jako aktywny" 
                        HorizontalAlignment="Stretch" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Click="SetActiveButton_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>