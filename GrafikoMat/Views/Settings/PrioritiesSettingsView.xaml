<UserControl
    x:Class="GrafikoMat.Views.Settings.PrioritiesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GrafikoMat.ViewModels"
    xmlns:common="using:GrafikoMat.Common"
    mc:Ignorable="d"
    x:Name="PrioritiesViewRoot">

    <UserControl.Resources>
        <common:RankToSizeConverter x:Key="RankToSizeConverter"/>
        <common:RankToBrushConverter x:Key="RankToBrushConverter"/>
        <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ZMIANA: Minimalny override dla CheckBox zamiast pełnego custom stylu -->
        <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <!-- Usuń domyślne marginesy i paddingi -->
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>

            <!-- Wycentruj kontrolkę -->
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- Wymuś rozmiar całej kontrolki (bez contentu - brak labela) -->
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kolejność Priorytetów" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8">
            Wybierz i uporządkuj kryteria, według których silnik będzie optymalizował grafik. 
            Wyższe na liście oznacza ważniejsze.
        </TextBlock>

        <TextBlock Grid.Row="2" Text="Aktywne priorytety (kolejność ma znaczenie)" FontWeight="SemiBold" Margin="0,20,0,8"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="400">
            <ListView x:Name="ActivePrioritiesListView" 
                      ItemsSource="{x:Bind ViewModel.ActivePriorities, Mode=OneWay}"
                      CanReorderItems="True"
                      AllowDrop="True"
                      SelectionMode="None">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PriorityOptionViewModel">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                MinWidth="400">
                            <Grid MinHeight="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kolumna strzałek -->
                                    <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="12,0,0,0">
                                        <Button VerticalAlignment="Top"
                                            Command="{x:Bind MoveUpCommand}"
                                            Visibility="{x:Bind IsMoveUpEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="6" Height="32">
                                            <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                                        </Button>
                                        <Button VerticalAlignment="Bottom"
                                            Command="{x:Bind MoveDownCommand}"
                                            Visibility="{x:Bind IsMoveDownEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="6" Height="32">
                                            <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <!-- Kółko z rangą -->
                                    <Border Grid.Column="1"
                                        Width="{x:Bind Rank, Mode=OneWay, Converter={StaticResource RankToSizeConverter}}"
                                        Height="{x:Bind Rank, Mode=OneWay, Converter={StaticResource RankToSizeConverter}}"
                                        Background="{x:Bind Rank, Mode=OneWay, Converter={StaticResource RankToBrushConverter}}"
                                        CornerRadius="100"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind Rank, Mode=OneWay}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimary}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform Y="-0.5"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>

                                    <!-- Nazwa i opis -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ZMIANA: Natywny CheckBox z minimalnym custom stylem -->
                                <CheckBox Grid.Column="1"
                                      Style="{StaticResource CompactCheckBoxStyle}"
                                      IsChecked="{x:Bind IsActive, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="Nieaktywne priorytety" FontWeight="SemiBold" Margin="0,20,0,8"/>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" MaxHeight="300">
            <ListView ItemsSource="{x:Bind ViewModel.InactivePriorities, Mode=OneWay}"
                      SelectionMode="None">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PriorityOptionViewModel">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Opacity="0.5"
                                MinWidth="400">
                            <Grid MinHeight="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,0,12,0">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- ZMIANA: Natywny CheckBox z minimalnym custom stylem -->
                                <CheckBox Grid.Column="1"
                                      Style="{StaticResource CompactCheckBoxStyle}"
                                      IsChecked="{x:Bind IsActive, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <Button Grid.Row="6"
                Content="Zapisz ustawienia"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.SaveCommand}"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"/>
    </Grid>
</UserControl>