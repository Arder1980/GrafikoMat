<UserControl
    x:Class="GrafikoMat.Views.Settings.PrioritiesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GrafikoMat.ViewModels"
    xmlns:common="using:GrafikoMat.Common"
    mc:Ignorable="d"
    x:Name="PrioritiesViewRoot">

    <UserControl.Resources>
        <common:RankToSizeConverter x:Key="RankToSizeConverter"/>
        <common:RankToBrushConverter x:Key="RankToBrushConverter"/>
        <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ZMIANA: Minimalny override dla CheckBox zamiast pełnego custom stylu -->
        <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <!-- Usuń domyślne marginesy i paddingi -->
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>

            <!-- Wycentruj kontrolkę -->
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- Wymuś rozmiar całej kontrolki (bez contentu - brak labela) -->
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,8,16">
        <StackPanel Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <TextBlock Text="Kolejność Priorytetów" FontSize="20" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8">
                Wybierz i uporządkuj kryteria, według których silnik będzie optymalizował grafik.
                Wyższe na liście oznacza ważniejsze.
            </TextBlock>

            <TextBlock Text="Aktywne priorytety (kolejność ma znaczenie)" FontWeight="SemiBold" Margin="0,12,0,0"/>

            <ListView x:Name="ActivePrioritiesListView"
                      ItemsSource="{x:Bind ViewModel.ActivePriorities, Mode=OneWay}"
                      CanReorderItems="True"
                      AllowDrop="True"
                      SelectionMode="None"
                      Margin="0,0,0,8">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel>
                            <ItemsStackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition/>
                                    <RepositionThemeTransition/>
                                </TransitionCollection>
                            </ItemsStackPanel.ChildrenTransitions>
                        </ItemsStackPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PriorityOptionViewModel">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                MinWidth="400">
                            <Border.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition/>
                                </TransitionCollection>
                            </Border.Transitions>
                            <Grid MinHeight="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kolumna strzałek -->
                                    <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="12,0,0,0">
                                        <Button VerticalAlignment="Top"
                                            Command="{x:Bind MoveUpCommand}"
                                            Visibility="{x:Bind IsMoveUpEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="6" Height="32">
                                            <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                                        </Button>
                                        <Button VerticalAlignment="Bottom"
                                            Command="{x:Bind MoveDownCommand}"
                                            Visibility="{x:Bind IsMoveDownEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="6" Height="32">
                                            <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <!-- Kółko z rangą -->
                                    <Border Grid.Column="1"
                                        Width="{x:Bind Rank, Mode=OneWay, Converter={StaticResource RankToSizeConverter}}"
                                        Height="{x:Bind Rank, Mode=OneWay, Converter={StaticResource RankToSizeConverter}}"
                                        Background="{x:Bind Rank, Mode=OneWay, Converter={StaticResource RankToBrushConverter}}"
                                        CornerRadius="100"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind Rank, Mode=OneWay}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimary}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform Y="-0.5"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>

                                    <!-- Nazwa i opis -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ZMIANA: Natywny CheckBox z minimalnym custom stylem -->
                                <CheckBox Grid.Column="1"
                                      Style="{StaticResource CompactCheckBoxStyle}"
                                      IsChecked="{x:Bind IsActive, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Nieaktywne priorytety" FontWeight="SemiBold" Margin="0,12,0,0"/>

            <ListView ItemsSource="{x:Bind ViewModel.InactivePriorities, Mode=OneWay}"
                      SelectionMode="None"
                      Margin="0,0,0,8">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel>
                            <ItemsStackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition/>
                                    <RepositionThemeTransition/>
                                </TransitionCollection>
                            </ItemsStackPanel.ChildrenTransitions>
                        </ItemsStackPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PriorityOptionViewModel">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Opacity="0.5"
                                MinWidth="400">
                            <Border.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition/>
                                </TransitionCollection>
                            </Border.Transitions>
                            <Grid MinHeight="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,0,12,0">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- ZMIANA: Natywny CheckBox z minimalnym custom stylem -->
                                <CheckBox Grid.Column="1"
                                      Style="{StaticResource CompactCheckBoxStyle}"
                                      IsChecked="{x:Bind IsActive, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>