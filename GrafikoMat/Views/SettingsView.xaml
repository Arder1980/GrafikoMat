<UserControl
    x:Class="GrafikoMat.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GrafikoMat.Views"
    xmlns:common="using:GrafikoMat.Common"
    mc:Ignorable="d">

    <UserControl.Resources>
        <common:NullToVisibilityConverter x:Key="NullToVisibleConverter" Invert="False"/>
        <common:NullToVisibilityConverter x:Key="NullToCollapsedConverter" Invert="True"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListView x:Name="SettingsMenu"
                  Grid.Column="0"
                  SelectionMode="Single"
                  SelectionChanged="SettingsMenu_SelectionChanged"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="MinHeight" Value="72"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SettingsMenuItem">
                    <Grid MinHeight="56" Padding="12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{x:Bind Title}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid Padding="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{x:Bind SettingsMenu.SelectedItem, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE713;" FontSize="48" Opacity="0.5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Wybierz kategorię z menu po lewej stronie."
                               Margin="0,12,0,0"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>

                <ContentControl x:Name="SettingsDetailContent"
                                Visibility="{x:Bind SettingsMenu.SelectedItem, Converter={StaticResource NullToVisibleConverter}, Mode=OneWay}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>