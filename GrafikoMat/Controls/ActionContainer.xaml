<UserControl
    x:Class="GrafikoMat.Controls.ActionContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF0A540A"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF6A0A0A"/>

        <Storyboard x:Name="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentHost"
                           Storyboard.TargetProperty="Opacity"
                           To="0.0"
                           Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentHost"
                           Storyboard.TargetProperty="Opacity"
                           To="1.0"
                           Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="InfoBarFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer"
                           Storyboard.TargetProperty="Opacity"
                           From="0.0"
                           To="1.0"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="InfoBarFadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer"
                           Storyboard.TargetProperty="Opacity"
                           To="0.0"
                           Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <ContentPresenter x:Name="ContentHost" Content="{x:Bind Content, Mode=OneWay}"/>

        <!-- Istniejący overlay dla komunikatów i busy indicator -->
        <Grid x:Name="OverlayHost" Visibility="Collapsed">
            <ProgressRing x:Name="ActionProgressRing" IsActive="False" Width="48" Height="48"/>

            <Grid x:Name="InfoBarContainer" 
                  Opacity="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MinWidth="340"
                  MaxWidth="500">

                <!-- Custom InfoBar -->
                <Grid x:Name="CustomInfoBar" 
                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                      Padding="0"
                      CornerRadius="10"
                      Visibility="Collapsed">

                    <!-- Miękki cień -->
                    <Grid.Shadow>
                        <media:ThemeShadow/>
                    </Grid.Shadow>

                    <!-- Subtelna ramka w kolorze systemowym -->
                    <Border BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lewy pasek koloru -->
                        <Border x:Name="StatusBorder" 
                                Grid.Column="0"
                                Background="#10B981"
                                CornerRadius="10,0,0,10"/>

                        <!-- Ikona (większa o 50%, wycentrowana) -->
                        <Grid Grid.Column="1" 
                              Width="64" 
                              Margin="16,16,16,16">
                            <Viewbox Width="72" Height="72">
                                <FontIcon x:Name="StatusIcon" 
                                          Glyph="&#xF13E;" 
                                          Foreground="#10B981"
                                          FontWeight="Bold"/>
                            </Viewbox>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Grid.Column="1"
                                   Width="1"
                                   Opacity="0.1"
                                   Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="0,12,0,12"
                                   HorizontalAlignment="Right"/>

                        <!-- Tekst -->
                        <StackPanel Grid.Column="2" 
                                    Margin="20,16,24,16"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <TextBlock x:Name="InfoTitle" 
                                       Text="Tytuł"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="InfoMessage" 
                                       Text="Wiadomość"
                                       FontSize="13"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- NOWY: Progress Overlay dla długotrwałych operacji -->
        <Grid x:Name="ProgressOverlay" Visibility="Collapsed">
            <!-- Przygaszające tło -->
            <Rectangle Fill="{ThemeResource SystemControlAcrylicElementBrush}" Opacity="0.95"/>

            <!-- Główny panel z contentem -->
            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32,24"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Shadow>
                    <media:ThemeShadow/>
                </Border.Shadow>

                <StackPanel Spacing="16">
                    <!-- Tytuł -->
                    <TextBlock x:Name="ProgressTitle" 
                               Text="Generowanie grafiku" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <!-- Nazwa silnika -->
                    <TextBlock x:Name="ProgressEngineName" 
                               Text="Silnik: GeneticSolver (algorytm genetyczny)" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <!-- ProgressBar (dla metaheurystyk) -->
                    <ProgressBar x:Name="DeterminateProgress" 
                                 Value="0" 
                                 Maximum="100" 
                                 Height="6"
                                 Visibility="Collapsed"/>

                    <!-- ProgressRing (dla Backtracking/A*) -->
                    <ProgressRing x:Name="IndeterminateProgress" 
                                  IsActive="False" 
                                  Width="48" 
                                  Height="48"
                                  HorizontalAlignment="Center"
                                  Visibility="Collapsed"/>

                    <!-- Tekst statusu -->
                    <TextBlock x:Name="ProgressStatusText" 
                               Text="Inicjalizacja..." 
                               FontSize="14"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="420"/>

                    <!-- Przycisk Cancel -->
                    <Button x:Name="CancelButton" 
                            Content="Anuluj" 
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="OnCancelClicked"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
