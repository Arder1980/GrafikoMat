<UserControl
    x:Class="GrafikoMat.Controls.ActionContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF0A540A"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF6A0A0A"/>
    </UserControl.Resources>

    <Grid>
        <ContentPresenter x:Name="ContentHost" Content="{x:Bind Content, Mode=OneWay}"/>

        <Grid x:Name="OverlayHost" Visibility="Collapsed" Canvas.ZIndex="1">

            <Grid>
                <Grid.Background>
                    <media:AcrylicBrush
                        TintOpacity="0.1"
                        TintColor="{ThemeResource SystemChromeAltLowColor}"/>
                </Grid.Background>
            </Grid>

            <ProgressRing x:Name="ActionProgressRing" IsActive="False" Width="48" Height="48"/>

            <Grid Translation="0,0,32"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MinWidth="340"
                  MaxWidth="500">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>

                <InfoBar x:Name="ActionInfoBar"
                         IsOpen="False"
                         IsClosable="False"
                         CornerRadius="6"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>