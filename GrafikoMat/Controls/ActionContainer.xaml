<UserControl
    x:Class="GrafikoMat.Controls.ActionContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <Grid>
        <ContentPresenter x:Name="ContentHost" Content="{x:Bind Content, Mode=OneWay}"/>

        <Grid x:Name="OverlayHost" Visibility="Collapsed" Canvas.ZIndex="1">

			<Grid x:Name="BackgroundGrid" />
			
            <ProgressRing x:Name="ActionProgressRing" IsActive="False" Width="48" Height="48"/>

            <InfoBar x:Name="ActionInfoBar"
                     IsOpen="False"
                     IsClosable="False"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MinWidth="340"
                     MaxWidth="500"/>
        </Grid>
    </Grid>
</UserControl>